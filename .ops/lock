            "cargo-binstall"
          ]
        },
        "cargo-nextest": {
          "args": "--disable-strategies compile",
          "musl": true,
          "version": "0.9.144",
          "needs": [
            "cargo-binstall"
          ]
        },
        "cargo-tarpaulin": {
          "args": "--disable-strategies compile",
          "musl": true,
          "version": "0.35.4",
          "needs": [
            "cargo-binstall"
          ]
        },
        "cargo-zigbuild": {
          "args": "--disable-strategies compile",
          "musl": true,
          "version": "0.22.1",
