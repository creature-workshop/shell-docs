  },
  "dependencies": {
    "tools": {
      "cargo-binstall": {
        "cargo-audit": {
          "args": "--disable-strategies compile",
          "version": "0.22.2",
          "needs": [
            "cargo-binstall"
          ]
        },
        "cargo-fuzz": {
          "args": "--disable-strategies compile",
          "musl": true,
          "version": "0.13.2",
          "needs": [
            "cargo-binstall"
          ]
        },
        "cargo-llvm-cov": {
          "args": "--disable-strategies compile",
          "musl": true,
          "version": "0.9.1",
