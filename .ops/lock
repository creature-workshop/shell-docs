          "version": "1.39.0"
        },
        "llvm-strip": {
          "version": "14"
        },
        "node": {
          "needs": [
            "fnm"
          ],
          "version": "24.20.0"
        },
        "rustup": {
          "components": [
            "rustfmt",
            "clippy",
            "llvm-tools"
          ],
          "needs": [
            "build-essential",
            "curl",
            "ca-certificates"
          ],
          "toolchain": "1.95.0",
          "version": "1.28.2"
        },
        "tectonic": {
          "needs": [
            "curl",
            "ca-certificates"
          ],
          "version": "0.15.0"
        },
        "terraform": {
          "needs": [
            "curl",
            "ca-certificates",
            "unzip"
          ],
          "version": "1.16.4"
        },
        "vercel": {
          "needs": [
            "node"
          ],
          "version": "59.10.0"
        },
        "zig": {
          "needs": [
            "build-essential"
          ],
          "version": "0.16.0"
        },
        "go": {
          "version": "1.25.5"
        }
      },
      "system": {
        "build-essential": {
          "version": "latest"
        },
        "ca-certificates": {
          "version": "latest"
        },
        "curl": {
          "version": "latest"
        },
        "direnv": {
          "postinstall": ".scripts/shim_direnv.sh"
        },
        "git": {
          "version": "latest"
        },
        "jq": {
          "version": "1.7.1"
        },
        "libssl-dev": {
          "version": "latest"
        },
        "openssh-client": {
          "version": "latest"
        },
        "openssl": {
          "version": "latest"
        },
        "pandoc": {
          "version": "latest"
        },
        "parallel": {
          "version": "latest"
        },
        "pkg-config": {
          "version": "latest"
        },
        "shellcheck": {
          "version": "0.9.0"
        },
        "strace": {
          "version": "5.16"
        },
        "sudo": {
          "version": "latest"
        },
        "unzip": {
          "version": "latest"
        }
      }
